def slot (x : Fin 16 × Fin 2) : Fin 32 := ⟨2*x.1.val+x.2.val,by omega⟩
private theorem slot_bij : Function.Bijective slot := by decide
private theorem pos_bij : Function.Bijective positive := by decide
private theorem neg_bij : Function.Bijective negative := by decide
noncomputable def tiling : Tiling (Fin 16) (Fin 32) (Fin 16) (Fin 16) where
  slots := {
    positive := (Equiv.ofBijective slot slot_bij).trans (Equiv.ofBijective positive pos_bij)
    negative := (Equiv.ofBijective slot slot_bij).trans (Equiv.ofBijective negative neg_bij) }
  black := black
  white := white
  faceBlack := faceBlack
  faceWhite := faceWhite
  positive_black := by intro f i; fin_cases f <;> fin_cases i <;> rfl
  positive_white := by intro f i; fin_cases f <;> fin_cases i <;> rfl
  negative_black := by intro f i; fin_cases f <;> fin_cases i <;> rfl
  negative_white := by intro f i; fin_cases f <;> fin_cases i <;> rfl

