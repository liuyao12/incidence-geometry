def dartTable : Fin 12 → Fin 4 → Fin 24 × Fin 2 := ![![(0,0),(9,0),(2,1),(1,1)],![(2,0),(11,0),(4,1),(3,1)],![(4,0),(13,0),(6,1),(5,1)],![(6,0),(15,0),(0,1),(7,1)],![(8,0),(17,0),(10,1),(9,1)],![(10,0),(19,0),(12,1),(11,1)],![(12,0),(21,0),(14,1),(13,1)],![(14,0),(23,0),(8,1),(15,1)],![(16,0),(1,0),(18,1),(17,1)],![(18,0),(3,0),(20,1),(19,1)],![(20,0),(5,0),(22,1),(21,1)],![(22,0),(7,0),(16,1),(23,1)]]
def dartMap (d : Fin 12 × Fin 4) : Fin 24 × Fin 2 := dartTable d.1 d.2
private theorem dartMap_bijective : Function.Bijective dartMap := by decide
noncomputable def torus : Quadrangulation (Fin 12) (Fin 24) (Fin 12) where
  darts := Equiv.ofBijective dartMap dartMap_bijective
  source := source
  target := target
  vertex := vertex
  starts := by decide
  ends := by decide

